{
  "name": "@marchen/core",
  "version": "0.8.2",
  "private": true,
  "description": "Core workflow layer for Marchen",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@marchen/config": "workspace:*",
    "@marchen/fs": "workspace:*",
    "@marchen/shared": "workspace:*",
    "@tobilu/qmd": "^2.1.0",
    "node-llama-cpp": "^3.18.1"
  }
}
